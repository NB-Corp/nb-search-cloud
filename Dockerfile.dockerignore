# Context is systems/. Default deny every System and every generated/private artifact.
**
# Do not negate parent directories: Docker would implicitly include their unlisted children.
!nb-search/package.json
!nb-search/pnpm-lock.yaml
!nb-search/tsconfig.json
!nb-search/tsdown.config.ts
!nb-search/src/**
!nb-search/README.md
!nb-search/CHANGELOG.md
!nb-search/LICENSE
!nb-search/SKILL.md
!nb-search/docs/model-facing-lane-runtime.md
!nb-search/docs/remote-protocol.md
!nb-search/docs/cli.md
!nb-search/scripts/nb-search.mjs
!nb-search/skills/nb-search/**
!nb-search-cloud/Dockerfile
!nb-search-cloud/Dockerfile.dockerignore
!nb-search-cloud/package.json
!nb-search-cloud/pnpm-lock.yaml
!nb-search-cloud/tsconfig.json
!nb-search-cloud/src/**
!nb-search-cloud/migrations/*.sql
!nb-search-cloud/web/package.json
!nb-search-cloud/web/pnpm-lock.yaml
!nb-search-cloud/web/tsconfig.json
!nb-search-cloud/web/vite.config.ts
!nb-search-cloud/web/index.html
!nb-search-cloud/web/src/**
!nb-search-cloud/web/public/favicon.svg
# Defense in depth even if such files appear under an admitted source directory.
**/.*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/.env*
**/.npmrc
**/.git/**
**/.tmp/**
**/.release-check/**
**/node_modules/**
**/*.map
**/*.tsbuildinfo
**/*.test.*
**/*.spec.*
**/__tests__/**
**/test-results/**
**/playwright-report/**
**/screenshots/**
**/browserartifacts/**
