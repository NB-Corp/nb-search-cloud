# Runtime DML credential only. Supply a unique password using protected deployment configuration.
# Keep administrator and migration credentials OUT of the running HTTP/worker environment.
DATABASE_URL=
# URLs require explicit username/password/host/database; an omitted port means 5432.
# Only application_name and sslmode=disable|verify-full query options are accepted, without duplicates.
# No-query URLs use ssl=false; PG* environment variables cannot supply missing identity/target fields.
# One-time/repeatable role provisioning: set all three URLs for the SAME database, distinct DEDICATED users.
# WARNING: passwords/privileges/memberships of named existing roles change CLUSTER-WIDE.
# Never point provisioning at shared roles; database/schema grants alone are database-scoped.
#   pnpm db:provision   (privileged DATABASE_ADMIN_URL creates/repairs owner/runtime roles)
#   pnpm db:migrate     (MIGRATION_DATABASE_URL owns schema; grants/revokes runtime DML)
#   pnpm start         (DATABASE_URL only, plus service settings below)
# owner/runtime passwords must each be >=12 characters; neither has superuser/CREATEROLE.
DATABASE_ADMIN_URL=
MIGRATION_DATABASE_URL=
# Isolated fake PG testing: node scripts/test-db.mjs --with pnpm test:identity
# That controller records exact container IDs and provisions/grants both identities automatically.
# Host development defaults below. Vite proxy users must set PUBLIC_ORIGIN to the exact browser origin.
# Container: HOST=0.0.0.0, COOKIE_MODE=production, PUBLIC_ORIGIN=https://your-real-public-origin.
# TLS is terminated by your existing reverse proxy/platform, not this API process.
PUBLIC_ORIGIN=http://127.0.0.1:3000
COOKIE_MODE=loopback
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# Supply BOTH through protected deployment configuration; no default key is generated.
# Master key: canonical base64 encoding of 32 random bytes. Key ID: deployment-owned stable identifier.
# Leaving both empty permits management/API-only setup, but credential-backed execution is unavailable.
CLOUD_SECRET_MASTER_KEY=
CLOUD_SECRET_KEY_ID=
# Optional override: choose a dedicated writable directory, never a personal nb-search HOME.
# The image defaults to /var/lib/nbcloud/execution (owned by uid/gid 10001).
# Host execution defaults to .local/cloud-execution. Do not set this variable to an empty string.
# CLOUD_EXECUTION_HOME=/var/lib/nbcloud/execution
# Build web separately with pnpm --dir web install --frozen-lockfile && pnpm web:build.
# With web/dist absent, startup reports console_static enabled=false and remains API-only.
# Optional tuning; values are bounded by the service.
LOGIN_IP_LIMIT=20
LOGIN_ACCOUNT_LIMIT=10
